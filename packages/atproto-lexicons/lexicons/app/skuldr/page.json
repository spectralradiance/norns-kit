{
  "lexicon": 1,
  "id": "app.skuldr.page",
  "description": "DRAFT. A page on the user's personal site. The record key is the URL slug; 'self' is the home page.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["title", "blocks", "createdAt"],
        "properties": {
          "title": { "type": "string", "maxLength": 1000, "maxGraphemes": 100 },
          "blocks": {
            "type": "array",
            "maxLength": 200,
            "items": {
              "type": "union",
              "refs": ["#markdownBlock", "#linksBlock", "#galleryBlock", "#feedBlock"]
            }
          },
          "navOrder": { "type": "integer", "minimum": 0 },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "markdownBlock": {
      "type": "object",
      "description": "CommonMark only; raw HTML is not rendered.",
      "required": ["text"],
      "properties": { "text": { "type": "string", "maxLength": 100000 } }
    },
    "linksBlock": {
      "type": "object",
      "required": ["links"],
      "properties": {
        "links": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "ref", "ref": "#link" }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["url", "label"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string", "maxLength": 300 }
      }
    },
    "galleryBlock": {
      "type": "object",
      "required": ["gallery"],
      "properties": { "gallery": { "type": "ref", "ref": "com.atproto.repo.strongRef" } }
    },
    "feedBlock": {
      "type": "object",
      "description": "Shows the user's recent posts, optionally limited to one tag.",
      "properties": {
        "tag": { "type": "string", "maxLength": 100 },
        "layout": { "type": "string", "knownValues": ["timeline", "grid", "magazine"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    }
  }
}
